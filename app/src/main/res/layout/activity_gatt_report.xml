<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New GATT report"
            android:textColor="#000000"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Send a detailed report to nearby connected phones."
            android:textColor="#000000"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Report type and severity"
            android:textColor="#000000"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/report_type"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:popupBackground="#000000"
                android:layout_weight="1" />

            <Spinner
                android:id="@+id/report_severity"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:popupBackground="#000000"
                android:layout_weight="1" />
        </LinearLayout>

        <EditText
            android:id="@+id/report_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="What happened? (optional)"
            android:textColor="#000000"
            android:textColorHint="#52606D"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="3" />

        <EditText
            android:id="@+id/report_reporter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your name (optional)"
            android:textColor="#000000"
            android:textColorHint="#52606D"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/report_contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contact information (optional)"
            android:textColor="#000000"
            android:textColorHint="#52606D"
            android:inputType="text" />

        <EditText
            android:id="@+id/report_people"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="People affected or needing help (optional)"
            android:textColor="#000000"
            android:textColorHint="#52606D"
            android:inputType="text" />

        <EditText
            android:id="@+id/report_assistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Assistance needed (optional)"
            android:textColor="#000000"
            android:textColorHint="#52606D"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/report_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Other information (optional)"
            android:textColor="#000000"
            android:textColorHint="#52606D"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="2" />

        <TextView
            android:id="@+id/report_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Location: not captured"
            android:textColor="#000000"
            android:textSize="14sp" />

        <Button
            android:id="@+id/report_location_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:text="Use phone location" />

        <Button
            android:id="@+id/report_send_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#000000"
            android:text="Send report over GATT" />

        <Button
            android:id="@+id/report_cancel_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:text="Cancel" />
    </LinearLayout>
</ScrollView>
